# 数据库连接
# 本地开发：SQLite 文件（不配置时默认 file:./db/custom.db）
DATABASE_URL=file:/absolute/path/to/db/custom.db

# 生产（Vercel Postgres / Neon）：
# 在 Vercel 项目集成 Neon 数据库后，DATABASE_URL 与 POSTGRES_PRISMA_URL
# 会由 Vercel 自动注入运行时环境，无需手动配置。
# 本地直连 Neon 时，把下方变量设为集成提供的连接串即可（优先使用 Prisma 调优串）：
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# POSTGRES_PRISMA_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
