generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 图片背景素材库（可扩充）
// 图片本体（JPEG）以二进制直接入库，天然跨平台持久化（本地 BLOB / Vercel Postgres BYTEA）
model Background {
  id        String   @id @default(cuid())
  label     String   @default("") // 展示名称
  origin    String   @default("upload") // upload | preset
  palette   String   @default("auto")   // 文字配色方案 key
  data      Bytes?   // 图片 JPEG 二进制
  createdAt DateTime @default(now())
}

// 文字素材库（可扩充）
model Quote {
  id        String   @id @default(cuid())
  content   String   // 正文，支持【高亮】与~~下划线~~标记
  footnote  String?  // 底部英文注脚（手写体）
  createdAt DateTime @default(now())
}

// 每日生成的日签记录
// 合成图（JPEG）同样入库：记录一经生成即永久留存，不依赖临时文件系统
model DailyCard {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD（Asia/Shanghai）
  backgroundId String
  quoteId      String
  variant      Int      @default(0) // 手动"换一换"次数，参与随机种子
  showDate     Boolean  @default(true) // 图片上是否绘制日期角标（可选显示项，默认显示）
  image        Bytes?   // 已合成日签 JPEG（置空则下次访问重生成）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt // 供图片 URL 缓存失效（素材/显隐变化即刷新）
}
