generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 图片背景素材库（可扩充）
model Background {
  id        String   @id @default(cuid())
  filename  String   // 存储文件名（storage/bg 目录下）
  label     String   @default("") // 展示名称
  origin    String   @default("upload") // upload | preset
  palette   String   @default("auto")   // 文字配色方案 key
  createdAt DateTime @default(now())
}

// 文字素材库（可扩充）
model Quote {
  id        String   @id @default(cuid())
  content   String   // 正文，支持【高亮】与~~下划线~~标记
  footnote  String?  // 底部英文注脚（手写体）
  createdAt DateTime @default(now())
}

// 每日生成的日签记录
model DailyCard {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD（Asia/Shanghai）
  backgroundId String
  quoteId      String
  variant      Int      @default(0) // 手动"换一换"次数，参与随机种子
  createdAt    DateTime @default(now())
}
